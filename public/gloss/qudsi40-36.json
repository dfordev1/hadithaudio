    "uh:token:qudsi-arbain.036:0196": { "en": "and speak", "ur": "اور کہو" },
    "uh:token:qudsi-arbain.036:0197": { "en": "it will be heard", "ur": "سنا جائے گا" },
    "uh:token:qudsi-arbain.036:0198": { "en": ",", "ur": "،" },
    "uh:token:qudsi-arbain.036:0199": { "en": "and intercede", "ur": "اور سفارش کرو" },
    "uh:token:qudsi-arbain.036:0200": { "en": "your intercession will be accepted", "ur": "تمہاری سفارش قبول ہو گی" },
    "uh:token:qudsi-arbain.036:0201": { "en": ".", "ur": "۔" },
    "uh:token:qudsi-arbain.036:0202": { "en": "so I shall raise", "ur": "پس میں اٹھاؤں گا" },
    "uh:token:qudsi-arbain.036:0203": { "en": "my head", "ur": "اپنا سر" },
    "uh:token:qudsi-arbain.036:0204": { "en": ",", "ur": "،" },
    "uh:token:qudsi-arbain.036:0205": { "en": "and I shall praise Him", "ur": "اور میں اُس کی حمد کروں گا" },
    "uh:token:qudsi-arbain.036:0206": { "en": "with a praise", "ur": "ایسی حمد سے" },
    "uh:token:qudsi-arbain.036:0207": { "en": "He will teach me", "ur": "جو وہ مجھے سکھائے گا" },
    "uh:token:qudsi-arbain.036:0208": { "en": ",", "ur": "،" },
    "uh:token:qudsi-arbain.036:0209": { "en": "then", "ur": "پھر" },
    "uh:token:qudsi-arbain.036:0210": { "en": "I shall intercede", "ur": "میں سفارش کروں گا" },
    "uh:token:qudsi-arbain.036:0211": { "en": ",", "ur": "،" },
    "uh:token:qudsi-arbain.036:0212": { "en": "and He will set", "ur": "اور وہ مقرر کر دے گا" },
    "uh:token:qudsi-arbain.036:0213": { "en": "for me", "ur": "میرے لیے" },
    "uh:token:qudsi-arbain.036:0214": { "en": "a limit", "ur": "ایک حد" },
    "uh:token:qudsi-arbain.036:0215": { "en": ",", "ur": "،" },
    "uh:token:qudsi-arbain.036:0216": { "en": "so I shall admit them", "ur": "پس میں اُنہیں داخل کروں گا" },
    "uh:token:qudsi-arbain.036:0217": { "en": "[into] Paradise", "ur": "جنت میں" },
    "uh:token:qudsi-arbain.036:0218": { "en": ".", "ur": "۔" },
    "uh:token:qudsi-arbain.036:0219": { "en": "then", "ur": "پھر" },
    "uh:token:qudsi-arbain.036:0220": { "en": "I shall return", "ur": "میں لوٹوں گا" },
    "uh:token:qudsi-arbain.036:0221": { "en": "to Him", "ur": "اُس کی طرف" },
    "uh:token:qudsi-arbain.036:0222": { "en": ",", "ur": "،" },
    "uh:token:qudsi-arbain.036:0223": { "en": "and when", "ur": "پھر جب" },
    "uh:token:qudsi-arbain.036:0224": { "en": "I see", "ur": "میں دیکھوں گا" },
    "uh:token:qudsi-arbain.036:0225": { "en": "my Lord", "ur": "اپنے رب کو" },
    "uh:token:qudsi-arbain.036:0226": { "en": "the same [as before]", "ur": "پہلے کی طرح" },
    "uh:token:qudsi-arbain.036:0227": { "en": ",", "ur": "،" },
    "uh:token:qudsi-arbain.036:0228": { "en": "then", "ur": "پھر" },
    "uh:token:qudsi-arbain.036:0229": { "en": "I shall intercede", "ur": "میں سفارش کروں گا" },
    "uh:token:qudsi-arbain.036:0230": { "en": "and He will set", "ur": "اور وہ مقرر کر دے گا" },
    "uh:token:qudsi-arbain.036:0231": { "en": "for me", "ur": "میرے لیے" },
    "uh:token:qudsi-arbain.036:0232": { "en": "a limit", "ur": "ایک حد" },
    "uh:token:qudsi-arbain.036:0233": { "en": ",", "ur": "،" },
    "uh:token:qudsi-arbain.036:0234": { "en": "so I shall admit them", "ur": "پس میں اُنہیں داخل کروں گا" },
    "uh:token:qudsi-arbain.036:0235": { "en": "[into] Paradise", "ur": "جنت میں" },
    "uh:token:qudsi-arbain.036:0236": { "en": ".", "ur": "۔" },
    "uh:token:qudsi-arbain.036:0237": { "en": "then", "ur": "پھر" },
    "uh:token:qudsi-arbain.036:0238": { "en": "I shall return", "ur": "میں لوٹوں گا" },
    "uh:token:qudsi-arbain.036:0239": { "en": "a third time", "ur": "تیسری بار" },
    "uh:token:qudsi-arbain.036:0240": { "en": ",", "ur": "،" },
    "uh:token:qudsi-arbain.036:0241": { "en": "then", "ur": "پھر" },
    "uh:token:qudsi-arbain.036:0242": { "en": "I shall return", "ur": "میں لوٹوں گا" },
    "uh:token:qudsi-arbain.036:0243": { "en": "a fourth time", "ur": "چوتھی بار" },
    "uh:token:qudsi-arbain.036:0244": { "en": ",", "ur": "،" },
    "uh:token:qudsi-arbain.036:0245": { "en": "and I shall say", "ur": "اور میں کہوں گا" },
    "uh:token:qudsi-arbain.036:0246": { "en": ":", "ur": "؛" },
    "uh:token:qudsi-arbain.036:0247": { "en": "none", "ur": "کوئی نہیں" },
    "uh:token:qudsi-arbain.036:0248": { "en": "remains", "ur": "باقی رہا" },
    "uh:token:qudsi-arbain.036:0249": { "en": "in", "ur": "میں" },
    "uh:token:qudsi-arbain.036:0250": { "en": "the Fire", "ur": "آگ" },
    "uh:token:qudsi-arbain.036:0251": { "en": "except", "ur": "سوائے" },
    "uh:token:qudsi-arbain.036:0252": { "en": "whom", "ur": "جسے" },
    "uh:token:qudsi-arbain.036:0253": { "en": "confined him", "ur": "روکے رکھا" },
    "uh:token:qudsi-arbain.036:0254": { "en": "the Quran", "ur": "قرآن نے" },
    "uh:token:qudsi-arbain.036:0255": { "en": ",", "ur": "،" },
    "uh:token:qudsi-arbain.036:0256": { "en": "and became binding", "ur": "اور واجب ہو گئی" },
    "uh:token:qudsi-arbain.036:0257": { "en": "upon him", "ur": "اُس پر" },
    "uh:token:qudsi-arbain.036:0258": { "en": "eternity [therein]", "ur": "ہمیشگی" }
  }
}
