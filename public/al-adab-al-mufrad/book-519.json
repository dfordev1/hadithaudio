{"book": 519, "hadith": [{"n": 1116, "src": {"f": "044-16467.mp3", "s": 383.05, "e": 409.67}, "tokens": [{"text": "حَدَّثَنَا", "start": 0.15, "end": 0.95}, {"text": "أَبُو", "start": 0.95, "end": 1.35}, {"text": "نُعَيْمٍ", "start": 1.35, "end": 2.31}, {"text": "قَالَ:", "start": 2.31, "end": 2.63}, {"text": "حَدَّثَنَا", "start": 2.63, "end": 3.43}, {"text": "زَكَرِيَّا", "start": 3.43, "end": 4.63}, {"text": "قَالَ:", "start": 4.63, "end": 4.95}, {"text": "سَمِعْتُ", "start": 4.95, "end": 5.59}, {"text": "عَامِرًا", "start": 5.59, "end": 6.39}, {"text": "يَقُولُ:", "start": 6.39, "end": 7.19}, {"text": "حَدَّثَنِي", "start": 7.19, "end": 8.07}, {"text": "أَبُو", "start": 8.07, "end": 8.55}, {"text": "سَلَمَةَ", "start": 8.55, "end": 9.19}, {"text": "بْنُ", "start": 9.19, "end": 9.59}, {"text": "عَبْدِ", "start": 9.59, "end": 10.15}, {"text": "الرَّحْمَنِ،", "start": 10.15, "end": 10.87}, {"text": "أَنَّ", "start": 10.87, "end": 11.19}, {"text": "عَائِشَةَ", "start": 11.19, "end": 11.83}, {"text": "حَدَّثَتْهُ،", "start": 11.83, "end": 12.79}, {"text": "أَنَّ", "start": 12.79, "end": 13.19}, {"text": "النَّبِيَّ", "start": 13.19, "end": 13.67}, {"text": "صَلَّى", "start": 13.67, "end": 14.15}, {"text": "اللهُ", "start": 14.15, "end": 14.39}, {"text": "عَلَيْهِ", "start": 14.39, "end": 14.87}, {"text": "وَسَلَّمَ", "start": 14.87, "end": 15.67}, {"text": "قَالَ", "start": 15.67, "end": 16.23}, {"text": "لَهَا:", "start": 16.23, "end": 17.19}, {"text": "«جِبْرِيلُ", "start": 17.19, "end": 17.99}, {"text": "يَقْرَأُ", "start": 17.99, "end": 18.63}, {"text": "عَلَيْكِ", "start": 18.63, "end": 19.19}, {"text": "السَّلَامَ» ،", "start": 19.19, "end": 20.23}, {"text": "فَقَالَتْ:", "start": 20.23, "end": 21.43}, {"text": "وَعَلَيْهِ", "start": 21.43, "end": 22.31}, {"text": "السَّلَامُ", "start": 22.31, "end": 23.11}, {"text": "وَرَحْمَةُ", "start": 23.11, "end": 23.83}, {"text": "اللَّهِ", "start": 23.83, "end": 26.07}, {"text": "صحيح", "start": 26.07, "end": 26.37, "es