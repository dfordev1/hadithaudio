      "position": 87,
      "text": "لَوْ",
      "start": 71.842,
      "end": 72.075
    },
    {
      "id": "uh:token:nawawi-arbain.024:0088",
      "position": 88,
      "text": "أَنَّ",
      "start": 72.109,
      "end": 72.539
    },
    {
      "id": "uh:token:nawawi-arbain.024:0089",
      "position": 89,
      "text": "أَوَّلَكُمْ",
      "start": 72.562,
      "end": 73.363
    },
    {
      "id": "uh:token:nawawi-arbain.024:0090",
      "position": 90,
      "text": "وَآخِرَكُمْ",
      "start": 73.398,
      "end": 74.443
    },
    {
      "id": "uh:token:nawawi-arbain.024:0091",
      "position": 91,
      "text": "وَإِنْسَكُمْ",
      "start": 74.478,
      "end": 75.395
    },
    {
      "id": "uh:token:nawawi-arbain.024:0092",
      "position": 92,
      "text": "وَجِنَّكُمْ",
      "start": 75.43,
      "end": 76.266
    },
    {
      "id": "uh:token:nawawi-arbain.024:0093",
      "position": 93,
      "text": "كَانُوا",
      "start": 76.312,
      "end": 76.904
    },
    {
      "id": "uh:token:nawawi-arbain.024:0094",
      "position": 94,
      "text": "عَلَى",
      "start": 76.927,
      "end": 77.276
    },
    {
      "id": "uh:token:nawawi-arbain.024:0095",
      "position": 95,
      "text": "أَفْجَرِ",
      "start": 77.357,
      "end": 78.007
    },
    {
      "id": "uh:token:nawawi-arbain.024:0096",
      "position": 96,
      "text": "قَلْبِ",
      "start": 78.03,
      "end": 78.472
    },
    {
      "id": "uh:token:nawawi-arbain.024:0097",
      "position": 97,
      "text": "رَجُلٍ",
      "start": 78.518,
      "end": 79.064
    },
    {
      "id": "uh:token:nawawi-arbain.024:0098",
      "position": 98,
      "text": "وَاحِدٍ",
      "start": 79.157,
      "end": 79.714
    },
    {
      "id": "uh:token:nawawi-arbain.024:0099",
      "position": 99,
      "text": "مِنْكُمْ،",
      "start": 79.784,
      "end": 80.503
    },
    {
      "id": "uh:token:nawawi-arbain.024:0100",
      "position": 100,
      "text": "مَا",
      "start": 80.701,
      "end": 80.898
    },
    {
      "id": "uh:token:nawawi-arbain.024:0101",
      "position": 101,
      "text": "نَقَصَ",
      "start": 80.979,
      "end": 81.444
    },
    {
      "id": "uh:token:nawawi-arbain.024:0102",
      "position": 102,
      "text": "ذَلِكَ",
      "start": 81.525,
      "end": 82.047
    },
    {
      "id": "uh:token:nawawi-arbain.024:0103",
      "position": 103,
      "text": "مِنْ",
      "start": 82.117,
      "end": 82.315
    },
    {
      "id": "uh:token:nawawi-arbain.024:0104",
      "position": 104,
      "text": "مُلْكِي",
      "start": 82.349,
      "end": 82.953
    },
    {
      "id": "uh:token:nawawi-arbain.024:0105",
      "position": 105,
      "text": "شَيْئًا.",
      "start": 83.034,
      "end": 83.801
    },
    {
      "id": "uh:token:nawawi-arbain.024:0106",
      "position": 106,
      "text": "يَا",
      "start": 84.033,
      "end": 84.23
    },
    {
      "id": "uh:token:nawawi-arbain.024:0107",
      "position": 107,
      "text": "عِبَادِي!",
      "start": 84.253,
      "end": 85.054
    },
    {
      "id": "uh:token:nawawi-arbain.024:0108",
      "position": 108,
      "text": "لَوْ",
      "start": 85.287,
      "end": 85.589
    },
    {
      "id": "uh:token:nawawi-arbain.024:0109",
      "position": 109,
      "text": "أَنَّ",
      "start": 85.623,
      "end": 85.983
    },
    {
      "id": "uh:token:nawawi-arbain.024:0110",
      "position": 110,
      "text": "أَوَّلَكُمْ",
      "start": 86.006,
      "end": 86.738
    },
    {
      "id": "uh:token:nawawi-arbain.024:0111",
      "position": 111,
      "text": "وَآخِرَكُمْ",
      "start": 86.761,
      "end": 87.876
    },
    {
      "id": "uh:token:nawawi-arbain.024:0112",
      "position": 112,
      "text": "وَإِنْسَكُمْ",
      "start": 87.911,
      "end": 88.863
    },
    {
      "id": "uh:token:nawawi-arbain.024:0113",
      "position": 113,
      "text": "وَجِنَّكُمْ",
      "start": 88.886,
      "end": 89.722
    },
    {
      "id": "uh:token:nawawi-arbain.024:0114",
      "position": 114,
      "text": "قَامُوا",
      "start": 89.85,
      "end": 90.523
    },
    {
      "id": "uh:token:nawawi-arbain.024:0115",
      "position": 115,
      "text": "فِي",
      "start": 90.558,
      "end": 90.743
    },
    {
      "id": "uh:token:nawawi-arbain.024:0116",
      "position": 116,
      "text": "صَعِيدٍ",
      "start": 90.871,
      "end": 91.568
    },
    {
      "id": "uh:token:nawawi-arbain.024:0117",
      "position": 117,
      "text": "وَاحِدٍ،",
      "start": 91.661,
      "end": 92.462
    },
    {
      "id": "uh:token:nawawi-arbain.024:0118",
      "position": 118,
      "text": "فَسَأَلُونِي،",
      "start": 92.659,
      "end": 93.855
    },
    {
      "id": "uh:token:nawawi-arbain.024:0119",
      "position": 119,
      "text": "فَأَعْطَيْت",
      "start": 94.052,
      "end": 94.958
    },
    {
      "id": "uh:token:nawawi-arbain.024:0120",
      "position": 120,
      "text": "كُلَّ",
      "start": 95.086,
      "end": 95.596
    },
    {
      "id": "uh:token:nawawi-arbain.024:0121",
      "position": 121,
      "text": "وَاحِدٍ",
      "start": 95.666,
      "end": 96.34
    },
    {
      "id": "uh:token:nawawi-arbain.024:0122",
      "position": 122,
      "text": "مَسْأَلَته،",
      "start": 96.421,
      "end": 97.431
    },
    {
      "id": "uh:token:nawawi-arbain.024:0123",
      "position": 123,
      "text": "مَا",
      "start": 97.593,
      "end": 97.918
    },
    {
      "id": "uh:token:nawawi-arbain.024:0124",
      "position": 124,
      "text": "نَقَصَ",
      "start": 98.046,
      "end": 98.662
    },
    {
      "id": "uh:token:nawawi-arbain.024:0125",
      "position": 125,
      "text": "ذَلِكَ",
      "start": 98.731,
      "end": 99.381
    },
    {
      "id": "uh:token:nawawi-arbain.024:0126",
      "position": 126,
      "text": "مِمَّا",
      "start": 99.463,
      "end": 100.194
    },
    {
      "id": "uh:token:nawawi-arbain.024:0127",
      "position": 127,
      "text": "عِنْدِي",
      "start": 100.275,
      "end": 100.925
    },
    {
      "id": "uh:token:nawawi-arbain.024:0128",
      "position": 128,
      "text": "إلَّا",
      "start": 101.192,
      "end": 101.796
    },
    {
      "id": "uh:token:nawawi-arbain.024:0129",
      "position": 129,
      "text": "كَمَا",
      "start": 101.959,
      "end": 102.423
    },
    {
      "id": "uh:token:nawawi-arbain.024:0130",
      "position": 130,
      "text": "يَنْقُصُ",
      "start": 102.528,
      "end": 103.155
    },
    {
      "id": "uh:token:nawawi-arbain.024:0131",
      "position": 131,
      "text": "الْمِخْيَطُ",
      "start": 103.189,
      "end": 104.141
    },
    {
      "id": "uh:token:nawawi-arbain.024:0132",
      "position": 132,
      "text": "إذَا",
      "start": 104.339,
      "end": 104.838
    },
    {
      "id": "uh:token:nawawi-arbain.024:0133",
      "position": 133,
      "text": "أُدْخِلَ",
      "start": 104.873,
      "end": 105.732
    },
    {
      "id": "uh:token:nawawi-arbain.024:0134",
      "position": 134,
      "text": "الْبَحْرَ.",
      "start": 105.767,
      "end": 106.707
    },
    {
      "id": "uh:token:nawawi-arbain.024:0135",
      "position": 135,
      "text": "يَا",
      "start": 107.949,
      "end": 108.217
    },
    {
      "id": "uh:token:nawawi-arbain.024:0136",
      "position": 136,
      "text": "عِبَادِي!",
      "start": 108.24,
      "end": 108.994
    },
    {
      "id": "uh:token:nawawi-arbain.024:0137",
      "position": 137,
      "text": "إنَّمَا",
      "start": 109.192,
      "end": 109.981
    },
    {
      "id": "uh:token:nawawi-arbain.024:0138",
      "position": 138,
      "text": "هِيَ",
      "start": 110.062,
      "end": 110.306
    },
    {
      "id": "uh:token:nawawi-arbain.024:0139",
      "position": 139,
      "text": "أَعْمَالُكُمْ",
      "start": 110.33,
      "end": 111.328
    },
    {
      "id": "uh:token:nawawi-arbain.024:0140",
      "position": 140,
      "text": "أُحْصِيهَا",
      "start": 111.363,
      "end": 112.292
    },
    {
      "id": "uh:token:nawawi-arbain.024:0141",
      "position": 141,
      "text": "لَكُمْ،",
      "start": 112.315,
      "end": 112.826
    },
    {
      "id": "uh:token:nawawi-arbain.024:0142",
      "position": 142,
      "text": "ثُمَّ",
      "start": 113.058,
      "end": 113.639
    },
    {
      "id": "uh:token:nawawi-arbain.024:0143",
      "position": 143,
      "text": "أُوَفِّيكُمْ",
      "start": 113.662,
      "end": 114.684
    },
    {
      "id": "uh:token:nawawi-arbain.024:0144",
      "position": 144,
      "text": "إيَّاهَا؛",
      "start": 114.718,
      "end": 115.74
    },
    {
      "id": "uh:token:nawawi-arbain.024:0145",
      "position": 145,
      "text": "فَمَنْ",
      "start": 115.972,
      "end": 116.437
    },
    {
      "id": "uh:token:nawawi-arbain.024:0146",
      "position": 146,
      "text": "وَجَدَ",
      "start": 116.483,
      "end": 117.017
    },
    {
      "id": "uh:token:nawawi-arbain.024:0147",
      "position": 147,
      "text": "خَيْرًا",
      "start": 117.11,
      "end": 117.714
    },
    {
      "id": "uh:token:nawawi-arbain.024:0148",
      "position": 148,
      "text": "فَلْيَحْمَدْ",
      "start": 117.807,
      "end": 118.747
    },
    {
      "id": "uh:token:nawawi-arbain.024:0149",
      "position": 149,
      "text": "اللَّهَ،",
      "start": 118.77,
      "end": 119.571
    },
    {
      "id": "uh:token:nawawi-arbain.024:0150",
      "position": 150,
      "text": "وَمَنْ",
      "start": 119.769,
      "end": 120.222
    },
    {
      "id": "uh:token:nawawi-arbain.024:0151",
      "position": 151,
      "text": "وَجَدَ",
      "start": 120.291,
      "end": 120.883
    },
    {
      "id": "uh:token:nawawi-arbain.024:0152",
      "position": 152,
      "text": "غَيْرَ",
      "start": 120.907,
      "end": 121.394
    },
    {
      "id": "uh:token:nawawi-arbain.024:0153",
      "position": 153,
      "text": "ذَلِكَ",
      "start": 121.464,
      "end": 122.01
    },
    {
      "id": "uh:token:nawawi-arbain.024:0154",
      "position": 154,
      "text": "فَلَا",
      "start": 122.137,
      "end": 122.625
    },
    {
      "id": "uh:token:nawawi-arbain.024:0155",
      "position": 155,
      "text": "يَلُومَن",
      "start": 122.753,
      "end": 123.565
    },
    {
      "id": "uh:token:nawawi-arbain.024:0156",
      "position": 156,
      "text": "إلَّا",
      "start": 123.705,
      "end": 124.262
    },
    {
      "id": "uh:token:nawawi-arbain.024:0157",
      "position": 157,
      "text": "نَفْسَهُ",
      "start": 124.355,
      "end": 125.202
    }
  ]
}
