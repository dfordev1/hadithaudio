      "text": "اللَّهِ.",
      "start": 80.72,
      "end": 81.92
    },
    {
      "id": "uh:token:nawawi-arbain.029:0092",
      "position": 92,
      "text": "قَالَ:",
      "start": 81.92,
      "end": 82.24
    },
    {
      "id": "uh:token:nawawi-arbain.029:0093",
      "position": 93,
      "text": "رَأْسُ",
      "start": 83.28,
      "end": 84.08
    },
    {
      "id": "uh:token:nawawi-arbain.029:0094",
      "position": 94,
      "text": "الْأَمْرِ",
      "start": 84.08,
      "end": 84.4
    },
    {
      "id": "uh:token:nawawi-arbain.029:0095",
      "position": 95,
      "text": "الْإِسْلَامُ،",
      "start": 84.64,
      "end": 86.56
    },
    {
      "id": "uh:token:nawawi-arbain.029:0096",
      "position": 96,
      "text": "وَعَمُودُهُ",
      "start": 86.64,
      "end": 87.68
    },
    {
      "id": "uh:token:nawawi-arbain.029:0097",
      "position": 97,
      "text": "الصَّلَاةُ،",
      "start": 87.68,
      "end": 89.04
    },
    {
      "id": "uh:token:nawawi-arbain.029:0098",
      "position": 98,
      "text": "وَذُرْوَةُ",
      "start": 89.04,
      "end": 89.92
    },
    {
      "id": "uh:token:nawawi-arbain.029:0099",
      "position": 99,
      "text": "سَنَامِهِ",
      "start": 89.92,
      "end": 90.72
    },
    {
      "id": "uh:token:nawawi-arbain.029:0100",
      "position": 100,
      "text": "الْجِهَادُ،",
      "start": 90.72,
      "end": 92.56
    },
    {
      "id": "uh:token:nawawi-arbain.029:0101",
      "position": 101,
      "text": "ثُمَّ",
      "start": 92.56,
      "end": 92.8
    },
    {
      "id": "uh:token:nawawi-arbain.029:0102",
      "position": 102,
      "text": "قَالَ:",
      "start": 92.96,
      "end": 93.36
    },
    {
      "id": "uh:token:nawawi-arbain.029:0103",
      "position": 103,
      "text": "أَلَا",
      "start": 94.24,
      "end": 94.8
    },
    {
      "id": "uh:token:nawawi-arbain.029:0104",
      "position": 104,
      "text": "أُخْبِرُك",
      "start": 94.8,
      "end": 95.76
    },
    {
      "id": "uh:token:nawawi-arbain.029:0105",
      "position": 105,
      "text": "بِمَلَاكِ",
      "start": 95.76,
      "end": 96.56
    },
    {
      "id": "uh:token:nawawi-arbain.029:0106",
      "position": 106,
      "text": "ذَلِكَ",
      "start": 96.56,
      "end": 96.88
    },
    {
      "id": "uh:token:nawawi-arbain.029:0107",
      "position": 107,
      "text": "كُلِّهِ؟",
      "start": 96.96,
      "end": 98.24
    },
    {
      "id": "uh:token:nawawi-arbain.029:0108",
      "position": 108,
      "text": "فقُلْت:",
      "start": 98.24,
      "end": 98.8
    },
    {
      "id": "uh:token:nawawi-arbain.029:0109",
      "position": 109,
      "text": "بَلَى",
      "start": 99.2,
      "end": 99.76
    },
    {
      "id": "uh:token:nawawi-arbain.029:0110",
      "position": 110,
      "text": "يَا",
      "start": 99.76,
      "end": 100.08
    },
    {
      "id": "uh:token:nawawi-arbain.029:0111",
      "position": 111,
      "text": "رَسُولَ",
      "start": 100.08,
      "end": 100.48
    },
    {
      "id": "uh:token:nawawi-arbain.029:0112",
      "position": 112,
      "text": "اللَّهِ",
      "start": 100.48,
      "end": 100.8
    },
    {
      "id": "uh:token:nawawi-arbain.029:0113",
      "position": 113,
      "text": "!",
      "start": null,
      "end": null
    },
    {
      "id": "uh:token:nawawi-arbain.029:0114",
      "position": 114,
      "text": "فَأَخَذَ",
      "start": 101.36,
      "end": 102.32
    },
    {
      "id": "uh:token:nawawi-arbain.029:0115",
      "position": 115,
      "text": "بِلِسَانِهِ",
      "start": 102.32,
      "end": 103.52
    },
    {
      "id": "uh:token:nawawi-arbain.029:0116",
      "position": 116,
      "text": "وَقَالَ:",
      "start": 103.52,
      "end": 103.84
    },
    {
      "id": "uh:token:nawawi-arbain.029:0117",
      "position": 117,
      "text": "كُفَّ",
      "start": 104.8,
      "end": 105.52
    },
    {
      "id": "uh:token:nawawi-arbain.029:0118",
      "position": 118,
      "text": "عَلَيْك",
      "start": 105.6,
      "end": 106
    },
    {
      "id": "uh:token:nawawi-arbain.029:0119",
      "position": 119,
      "text": "هَذَا.",
      "start": 106.32,
      "end": 107.92
    },
    {
      "id": "uh:token:nawawi-arbain.029:0120",
      "position": 120,
      "text": "قُلْت:",
      "start": 107.92,
      "end": 108.56
    },
    {
      "id": "uh:token:nawawi-arbain.029:0121",
      "position": 121,
      "text": "يَا",
      "start": 109.12,
      "end": 109.52
    },
    {
      "id": "uh:token:nawawi-arbain.029:0122",
      "position": 122,
      "text": "نَبِيَّ",
      "start": 109.52,
      "end": 110.08
    },
    {
      "id": "uh:token:nawawi-arbain.029:0123",
      "position": 123,
      "text": "اللَّهِ",
      "start": 110.08,
      "end": 110.4
    },
    {
      "id": "uh:token:nawawi-arbain.029:0124",
      "position": 124,
      "text": "وَإِنَّا",
      "start": 111.68,
      "end": 112.64
    },
    {
      "id": "uh:token:nawawi-arbain.029:0125",
      "position": 125,
      "text": "لَمُؤَاخَذُونَ",
      "start": 112.64,
      "end": 114
    },
    {
      "id": "uh:token:nawawi-arbain.029:0126",
      "position": 126,
      "text": "بِمَا",
      "start": 114,
      "end": 114.24
    },
    {
      "id": "uh:token:nawawi-arbain.029:0127",
      "position": 127,
      "text": "نَتَكَلَّمُ",
      "start": 114.24,
      "end": 114.88
    },
    {
      "id": "uh:token:nawawi-arbain.029:0128",
      "position": 128,
      "text": "بِهِ؟",
      "start": 115.04,
      "end": 116.08
    },
    {
      "id": "uh:token:nawawi-arbain.029:0129",
      "position": 129,
      "text": "فَقَالَ:",
      "start": 116.08,
      "end": 116.32
    },
    {
      "id": "uh:token:nawawi-arbain.029:0130",
      "position": 130,
      "text": "ثَكِلَتْك",
      "start": 117.28,
      "end": 118.4
    },
    {
      "id": "uh:token:nawawi-arbain.029:0131",
      "position": 131,
      "text": "أُمُّك",
      "start": 118.4,
      "end": 119.12
    },
    {
      "id": "uh:token:nawawi-arbain.029:0132",
      "position": 132,
      "text": "وَهَلْ",
      "start": 120.72,
      "end": 121.44
    },
    {
      "id": "uh:token:nawawi-arbain.029:0133",
      "position": 133,
      "text": "يَكُبُّ",
      "start": 121.44,
      "end": 122.08
    },
    {
      "id": "uh:token:nawawi-arbain.029:0134",
      "position": 134,
      "text": "النَّاسَ",
      "start": 122.08,
      "end": 122.4
    },
    {
      "id": "uh:token:nawawi-arbain.029:0135",
      "position": 135,
      "text": "عَلَى",
      "start": 123.36,
      "end": 123.76
    },
    {
      "id": "uh:token:nawawi-arbain.029:0136",
      "position": 136,
      "text": "وُجُوهِهِمْ",
      "start": 123.92,
      "end": 124.88
    },
    {
      "id": "uh:token:nawawi-arbain.029:0137",
      "position": 137,
      "text": "-أَوْ",
      "start": 125.6,
      "end": 126
    },
    {
      "id": "uh:token:nawawi-arbain.029:0138",
      "position": 138,
      "text": "قَالَ",
      "start": 126,
      "end": 126.4
    },
    {
      "id": "uh:token:nawawi-arbain.029:0139",
      "position": 139,
      "text": "عَلَى",
      "start": 127.2,
      "end": 127.6
    },
    {
      "id": "uh:token:nawawi-arbain.029:0140",
      "position": 140,
      "text": "مَنَاخِرِهِمْ-",
      "start": 127.6,
      "end": 128.8
    },
    {
      "id": "uh:token:nawawi-arbain.029:0141",
      "position": 141,
      "text": "إلَّا",
      "start": 128.96,
      "end": 129.36
    },
    {
      "id": "uh:token:nawawi-arbain.029:0142",
      "position": 142,
      "text": "حَصَائِدُ",
      "start": 129.44,
      "end": 130.32
    },
    {
      "id": "uh:token:nawawi-arbain.029:0143",
      "position": 143,
      "text": "أَلْسِنَتِهِمْ؟!\"",
      "start": 130.32,
      "end": 131.6
    },
    {
      "id": "uh:token:nawawi-arbain.029:0144",
      "position": 144,
      "text": ".",
      "start": 132.08,
      "end": 132.4
    },
    {
      "id": "uh:token:nawawi-arbain.029:0145",
      "position": 145,
      "text": "رَوَاهُ",
      "start": 132.4,
      "end": 133.04
    },
    {
      "id": "uh:token:nawawi-arbain.029:0146",
      "position": 146,
      "text": "التِّرْمِذِيُّ",
      "start": 133.04,
      "end": 133.92
    },
    {
      "id": "uh:token:nawawi-arbain.029:0147",
      "position": 147,
      "text": "وَقَالَ:",
      "start": 133.92,
      "end": 134.24
    },
    {
      "id": "uh:token:nawawi-arbain.029:0148",
      "position": 148,
      "text": "حَدِيثٌ",
      "start": 135.6,
      "end": 136
    },
    {
      "id": "uh:token:nawawi-arbain.029:0149",
      "position": 149,
      "text": "حَسَنٌ",
      "start": 136.64,
      "end": 137.04
    },
    {
      "id": "uh:token:nawawi-arbain.029:0150",
      "position": 150,
      "text": "صَحِيحٌ.",
      "start": 137.12,
      "end": 138.924
    }
  ]
}
