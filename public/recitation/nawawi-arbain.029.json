      "text": "اللَّهِ.",
      "start": 76.72,
      "end": 77.92
    },
    {
      "id": "uh:token:nawawi-arbain.029:0092",
      "position": 92,
      "text": "قَالَ:",
      "start": 77.92,
      "end": 78.24
    },
    {
      "id": "uh:token:nawawi-arbain.029:0093",
      "position": 93,
      "text": "رَأْسُ",
      "start": 79.28,
      "end": 80.08
    },
    {
      "id": "uh:token:nawawi-arbain.029:0094",
      "position": 94,
      "text": "الْأَمْرِ",
      "start": 80.08,
      "end": 80.4
    },
    {
      "id": "uh:token:nawawi-arbain.029:0095",
      "position": 95,
      "text": "الْإِسْلَامُ،",
      "start": 80.64,
      "end": 82.56
    },
    {
      "id": "uh:token:nawawi-arbain.029:0096",
      "position": 96,
      "text": "وَعَمُودُهُ",
      "start": 82.64,
      "end": 83.68
    },
    {
      "id": "uh:token:nawawi-arbain.029:0097",
      "position": 97,
      "text": "الصَّلَاةُ،",
      "start": 83.68,
      "end": 85.04
    },
    {
      "id": "uh:token:nawawi-arbain.029:0098",
      "position": 98,
      "text": "وَذُرْوَةُ",
      "start": 85.04,
      "end": 85.92
    },
    {
      "id": "uh:token:nawawi-arbain.029:0099",
      "position": 99,
      "text": "سَنَامِهِ",
      "start": 85.92,
      "end": 86.72
    },
    {
      "id": "uh:token:nawawi-arbain.029:0100",
      "position": 100,
      "text": "الْجِهَادُ،",
      "start": 86.72,
      "end": 88.56
    },
    {
      "id": "uh:token:nawawi-arbain.029:0101",
      "position": 101,
      "text": "ثُمَّ",
      "start": 88.56,
      "end": 88.8
    },
    {
      "id": "uh:token:nawawi-arbain.029:0102",
      "position": 102,
      "text": "قَالَ:",
      "start": 88.96,
      "end": 89.36
    },
    {
      "id": "uh:token:nawawi-arbain.029:0103",
      "position": 103,
      "text": "أَلَا",
      "start": 90.24,
      "end": 90.8
    },
    {
      "id": "uh:token:nawawi-arbain.029:0104",
      "position": 104,
      "text": "أُخْبِرُك",
      "start": 90.8,
      "end": 91.76
    },
    {
      "id": "uh:token:nawawi-arbain.029:0105",
      "position": 105,
      "text": "بِمَلَاكِ",
      "start": 91.76,
      "end": 92.56
    },
    {
      "id": "uh:token:nawawi-arbain.029:0106",
      "position": 106,
      "text": "ذَلِكَ",
      "start": 92.56,
      "end": 92.88
    },
    {
      "id": "uh:token:nawawi-arbain.029:0107",
      "position": 107,
      "text": "كُلِّهِ؟",
      "start": 92.96,
      "end": 94.24
    },
    {
      "id": "uh:token:nawawi-arbain.029:0108",
      "position": 108,
      "text": "فقُلْت:",
      "start": 94.24,
      "end": 94.8
    },
    {
      "id": "uh:token:nawawi-arbain.029:0109",
      "position": 109,
      "text": "بَلَى",
      "start": 95.2,
      "end": 95.76
    },
    {
      "id": "uh:token:nawawi-arbain.029:0110",
      "position": 110,
      "text": "يَا",
      "start": 95.76,
      "end": 96.08
    },
    {
      "id": "uh:token:nawawi-arbain.029:0111",
      "position": 111,
      "text": "رَسُولَ",
      "start": 96.08,
      "end": 96.48
    },
    {
      "id": "uh:token:nawawi-arbain.029:0112",
      "position": 112,
      "text": "اللَّهِ",
      "start": 96.48,
      "end": 96.8
    },
    {
      "id": "uh:token:nawawi-arbain.029:0113",
      "position": 113,
      "text": "!",
      "start": null,
      "end": null
    },
    {
      "id": "uh:token:nawawi-arbain.029:0114",
      "position": 114,
      "text": "فَأَخَذَ",
      "start": 97.36,
      "end": 98.32
    },
    {
      "id": "uh:token:nawawi-arbain.029:0115",
      "position": 115,
      "text": "بِلِسَانِهِ",
      "start": 98.32,
      "end": 99.52
    },
    {
      "id": "uh:token:nawawi-arbain.029:0116",
      "position": 116,
      "text": "وَقَالَ:",
      "start": 99.52,
      "end": 99.84
    },
    {
      "id": "uh:token:nawawi-arbain.029:0117",
      "position": 117,
      "text": "كُفَّ",
      "start": 100.8,
      "end": 101.52
    },
    {
      "id": "uh:token:nawawi-arbain.029:0118",
      "position": 118,
      "text": "عَلَيْك",
      "start": 101.6,
      "end": 102
    },
    {
      "id": "uh:token:nawawi-arbain.029:0119",
      "position": 119,
      "text": "هَذَا.",
      "start": 102.32,
      "end": 103.92
    },
    {
      "id": "uh:token:nawawi-arbain.029:0120",
      "position": 120,
      "text": "قُلْت:",
      "start": 103.92,
      "end": 104.56
    },
    {
      "id": "uh:token:nawawi-arbain.029:0121",
      "position": 121,
      "text": "يَا",
      "start": 105.12,
      "end": 105.52
    },
    {
      "id": "uh:token:nawawi-arbain.029:0122",
      "position": 122,
      "text": "نَبِيَّ",
      "start": 105.52,
      "end": 106.08
    },
    {
      "id": "uh:token:nawawi-arbain.029:0123",
      "position": 123,
      "text": "اللَّهِ",
      "start": 106.08,
      "end": 106.4
    },
    {
      "id": "uh:token:nawawi-arbain.029:0124",
      "position": 124,
      "text": "وَإِنَّا",
      "start": 107.68,
      "end": 108.64
    },
    {
      "id": "uh:token:nawawi-arbain.029:0125",
      "position": 125,
      "text": "لَمُؤَاخَذُونَ",
      "start": 108.64,
      "end": 110
    },
    {
      "id": "uh:token:nawawi-arbain.029:0126",
      "position": 126,
      "text": "بِمَا",
      "start": 110,
      "end": 110.24
    },
    {
      "id": "uh:token:nawawi-arbain.029:0127",
      "position": 127,
      "text": "نَتَكَلَّمُ",
      "start": 110.24,
      "end": 110.88
    },
    {
      "id": "uh:token:nawawi-arbain.029:0128",
      "position": 128,
      "text": "بِهِ؟",
      "start": 111.04,
      "end": 112.08
    },
    {
      "id": "uh:token:nawawi-arbain.029:0129",
      "position": 129,
      "text": "فَقَالَ:",
      "start": 112.08,
      "end": 112.32
    },
    {
      "id": "uh:token:nawawi-arbain.029:0130",
      "position": 130,
      "text": "ثَكِلَتْك",
      "start": 113.28,
      "end": 114.4
    },
    {
      "id": "uh:token:nawawi-arbain.029:0131",
      "position": 131,
      "text": "أُمُّك",
      "start": 114.4,
      "end": 115.12
    },
    {
      "id": "uh:token:nawawi-arbain.029:0132",
      "position": 132,
      "text": "وَهَلْ",
      "start": 116.72,
      "end": 117.44
    },
    {
      "id": "uh:token:nawawi-arbain.029:0133",
      "position": 133,
      "text": "يَكُبُّ",
      "start": 117.44,
      "end": 118.08
    },
    {
      "id": "uh:token:nawawi-arbain.029:0134",
      "position": 134,
      "text": "النَّاسَ",
      "start": 118.08,
      "end": 118.4
    },
    {
      "id": "uh:token:nawawi-arbain.029:0135",
      "position": 135,
      "text": "عَلَى",
      "start": 119.36,
      "end": 119.76
    },
    {
      "id": "uh:token:nawawi-arbain.029:0136",
      "position": 136,
      "text": "وُجُوهِهِمْ",
      "start": 119.92,
      "end": 120.88
    },
    {
      "id": "uh:token:nawawi-arbain.029:0137",
      "position": 137,
      "text": "-أَوْ",
      "start": 121.6,
      "end": 122
    },
    {
      "id": "uh:token:nawawi-arbain.029:0138",
      "position": 138,
      "text": "قَالَ",
      "start": 122,
      "end": 122.4
    },
    {
      "id": "uh:token:nawawi-arbain.029:0139",
      "position": 139,
      "text": "عَلَى",
      "start": 123.2,
      "end": 123.6
    },
    {
      "id": "uh:token:nawawi-arbain.029:0140",
      "position": 140,
      "text": "مَنَاخِرِهِمْ-",
      "start": 123.6,
      "end": 124.8
    },
    {
      "id": "uh:token:nawawi-arbain.029:0141",
      "position": 141,
      "text": "إلَّا",
      "start": 124.96,
      "end": 125.36
    },
    {
      "id": "uh:token:nawawi-arbain.029:0142",
      "position": 142,
      "text": "حَصَائِدُ",
      "start": 125.44,
      "end": 126.32
    },
    {
      "id": "uh:token:nawawi-arbain.029:0143",
      "position": 143,
      "text": "أَلْسِنَتِهِمْ؟!\"",
      "start": 126.32,
      "end": 127.6
    },
    {
      "id": "uh:token:nawawi-arbain.029:0144",
      "position": 144,
      "text": ".",
      "start": 128.08,
      "end": 128.4
    },
    {
      "id": "uh:token:nawawi-arbain.029:0145",
      "position": 145,
      "text": "رَوَاهُ",
      "start": 128.4,
      "end": 129.04
    },
    {
      "id": "uh:token:nawawi-arbain.029:0146",
      "position": 146,
      "text": "التِّرْمِذِيُّ",
      "start": 129.04,
      "end": 129.92
    },
    {
      "id": "uh:token:nawawi-arbain.029:0147",
      "position": 147,
      "text": "وَقَالَ:",
      "start": 129.92,
      "end": 130.24
    },
    {
      "id": "uh:token:nawawi-arbain.029:0148",
      "position": 148,
      "text": "حَدِيثٌ",
      "start": 131.6,
      "end": 132
    },
    {
      "id": "uh:token:nawawi-arbain.029:0149",
      "position": 149,
      "text": "حَسَنٌ",
      "start": 132.64,
      "end": 133.04
    },
    {
      "id": "uh:token:nawawi-arbain.029:0150",
      "position": 150,
      "text": "صَحِيحٌ.",
      "start": 133.12,
      "end": 134.924
    }
  ]
}
