      "text": "سَنَامِهِ",
      "start": 83.034,
      "end": 83.94
    },
    {
      "id": "uh:token:nawawi-arbain.029:0092",
      "position": 92,
      "text": "الْجِهَادُ،",
      "start": 83.986,
      "end": 85.159
    },
    {
      "id": "uh:token:nawawi-arbain.029:0093",
      "position": 93,
      "text": "ثُمَّ",
      "start": 85.728,
      "end": 86.25
    },
    {
      "id": "uh:token:nawawi-arbain.029:0094",
      "position": 94,
      "text": "قَالَ:",
      "start": 86.332,
      "end": 87.051
    },
    {
      "id": "uh:token:nawawi-arbain.029:0095",
      "position": 95,
      "text": "أَلَا",
      "start": 87.411,
      "end": 87.934
    },
    {
      "id": "uh:token:nawawi-arbain.029:0096",
      "position": 96,
      "text": "أُخْبِرُك",
      "start": 88.027,
      "end": 88.909
    },
    {
      "id": "uh:token:nawawi-arbain.029:0097",
      "position": 97,
      "text": "بِمَلَاكِ",
      "start": 89.072,
      "end": 89.977
    },
    {
      "id": "uh:token:nawawi-arbain.029:0098",
      "position": 98,
      "text": "ذَلِكَ",
      "start": 90.07,
      "end": 90.697
    },
    {
      "id": "uh:token:nawawi-arbain.029:0099",
      "position": 99,
      "text": "كُلِّهِ؟",
      "start": 90.778,
      "end": 91.591
    },
    {
      "id": "uh:token:nawawi-arbain.029:0100",
      "position": 100,
      "text": "فقُلْت:",
      "start": 92.264,
      "end": 93.239
    },
    {
      "id": "uh:token:nawawi-arbain.029:0101",
      "position": 101,
      "text": "بَلَى",
      "start": 93.507,
      "end": 94.064
    },
    {
      "id": "uh:token:nawawi-arbain.029:0102",
      "position": 102,
      "text": "يَا",
      "start": 94.226,
      "end": 94.366
    },
    {
      "id": "uh:token:nawawi-arbain.029:0103",
      "position": 103,
      "text": "رَسُولَ",
      "start": 94.795,
      "end": 95.608
    },
    {
      "id": "uh:token:nawawi-arbain.029:0104",
      "position": 104,
      "text": "اللَّهِ",
      "start": 95.643,
      "end": 96.142
    },
    {
      "id": "uh:token:nawawi-arbain.029:0105",
      "position": 105,
      "text": "!",
      "start": 96.177,
      "end": 96.305
    },
    {
      "id": "uh:token:nawawi-arbain.029:0106",
      "position": 106,
      "text": "فَأَخَذَ",
      "start": 96.618,
      "end": 97.361
    },
    {
      "id": "uh:token:nawawi-arbain.029:0107",
      "position": 107,
      "text": "بِلِسَانِهِ",
      "start": 97.454,
      "end": 98.615
    },
    {
      "id": "uh:token:nawawi-arbain.029:0108",
      "position": 108,
      "text": "وَقَالَ:",
      "start": 98.812,
      "end": 99.811
    },
    {
      "id": "uh:token:nawawi-arbain.029:0109",
      "position": 109,
      "text": "كُفَّ",
      "start": 100.484,
      "end": 101.157
    },
    {
      "id": "uh:token:nawawi-arbain.029:0110",
      "position": 110,
      "text": "عَلَيْك",
      "start": 101.227,
      "end": 101.854
    },
    {
      "id": "uh:token:nawawi-arbain.029:0111",
      "position": 111,
      "text": "هَذَا.",
      "start": 101.993,
      "end": 102.818
    },
    {
      "id": "uh:token:nawawi-arbain.029:0112",
      "position": 112,
      "text": "قُلْت:",
      "start": 103.178,
      "end": 103.932
    },
    {
      "id": "uh:token:nawawi-arbain.029:0113",
      "position": 113,
      "text": "يَا",
      "start": 104.199,
      "end": 104.501
    },
    {
      "id": "uh:token:nawawi-arbain.029:0114",
      "position": 114,
      "text": "نَبِيَّ",
      "start": 104.629,
      "end": 105.221
    },
    {
      "id": "uh:token:nawawi-arbain.029:0115",
      "position": 115,
      "text": "اللَّهِ",
      "start": 105.256,
      "end": 105.801
    },
    {
      "id": "uh:token:nawawi-arbain.029:0116",
      "position": 116,
      "text": "وَإِنَّا",
      "start": 106.034,
      "end": 106.916
    },
    {
      "id": "uh:token:nawawi-arbain.029:0117",
      "position": 117,
      "text": "لَمُؤَاخَذُونَ",
      "start": 107.079,
      "end": 108.623
    },
    {
      "id": "uh:token:nawawi-arbain.029:0118",
      "position": 118,
      "text": "بِمَا",
      "start": 108.785,
      "end": 109.273
    },
    {
      "id": "uh:token:nawawi-arbain.029:0119",
      "position": 119,
      "text": "نَتَكَلَّمُ",
      "start": 109.436,
      "end": 110.55
    },
    {
      "id": "uh:token:nawawi-arbain.029:0120",
      "position": 120,
      "text": "بِهِ؟",
      "start": 110.643,
      "end": 111.27
    },
    {
      "id": "uh:token:nawawi-arbain.029:0121",
      "position": 121,
      "text": "فَقَالَ:",
      "start": 111.502,
      "end": 112.454
    },
    {
      "id": "uh:token:nawawi-arbain.029:0122",
      "position": 122,
      "text": "ثَكِلَتْك",
      "start": 112.942,
      "end": 113.604
    },
    {
      "id": "uh:token:nawawi-arbain.029:0123",
      "position": 123,
      "text": "أُمُّك",
      "start": 113.731,
      "end": 114.219
    },
    {
      "id": "uh:token:nawawi-arbain.029:0124",
      "position": 124,
      "text": "وَهَلْ",
      "start": 114.486,
      "end": 114.915
    },
    {
      "id": "uh:token:nawawi-arbain.029:0125",
      "position": 125,
      "text": "يَكُبُّ",
      "start": 114.962,
      "end": 115.577
    },
    {
      "id": "uh:token:nawawi-arbain.029:0126",
      "position": 126,
      "text": "النَّاسَ",
      "start": 115.6,
      "end": 116.285
    },
    {
      "id": "uh:token:nawawi-arbain.029:0127",
      "position": 127,
      "text": "عَلَى",
      "start": 116.309,
      "end": 116.715
    },
    {
      "id": "uh:token:nawawi-arbain.029:0128",
      "position": 128,
      "text": "وُجُوهِهِمْ",
      "start": 116.808,
      "end": 117.83
    },
    {
      "id": "uh:token:nawawi-arbain.029:0129",
      "position": 129,
      "text": "-أَوْ",
      "start": 118.027,
      "end": 118.422
    },
    {
      "id": "uh:token:nawawi-arbain.029:0130",
      "position": 130,
      "text": "قَالَ",
      "start": 118.468,
      "end": 118.874
    },
    {
      "id": "uh:token:nawawi-arbain.029:0131",
      "position": 131,
      "text": "عَلَى",
      "start": 118.944,
      "end": 119.304
    },
    {
      "id": "uh:token:nawawi-arbain.029:0132",
      "position": 132,
      "text": "مَنَاخِرِهِمْ-",
      "start": 119.409,
      "end": 120.604
    },
    {
      "id": "uh:token:nawawi-arbain.029:0133",
      "position": 133,
      "text": "إلَّا",
      "start": 120.918,
      "end": 121.452
    },
    {
      "id": "uh:token:nawawi-arbain.029:0134",
      "position": 134,
      "text": "حَصَائِدُ",
      "start": 121.556,
      "end": 122.485
    },
    {
      "id": "uh:token:nawawi-arbain.029:0135",
      "position": 135,
      "text": "أَلْسِنَتِهِمْ؟!",
      "start": 122.532,
      "end": 123.995
    }
  ]
}
