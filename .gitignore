# Secrets — never commit
.env*
!.env.example

# Heavy local TTS install (3.3 GB: model weights, venv) — not part of the site
OmniVoice-Studio/

# Data-generation repo has its own remote (dfordev1/hadithusx)
hadithusx/

# Large build inputs, fetched on demand, not needed at runtime.
# Anchored to repo root so they don't also match published sidecars like
# public/refs/nawawi.json (an unanchored "nawawi.json" matches at any depth).
/ara-bukhari.json
/ara-muslim.json
/eng-nawawi.json
/nawawi.json

# OmniVoice A/B artifacts and the first prototype — production is ElevenLabs-only
public/omnivoice/
public/audio/

# Scratch / local test scripts
omni-test.py
omni-langs.py
pe-imports.py
check-boundaries.py
check-recitation.mjs
check-boundaries.mjs
inspect.mjs
probe-en.mjs

# OS / tooling
node_modules/
__pycache__/
qc/muwatta-full/
qc/tirmidhi-full/
qc/nasai-full/
qc/nasai-app-ready-full/
*.log
.DS_Store

# Collection build inputs (regeneration sources, not site runtime)
/qudsi-ar.json
/qudsi-en.json
/shahwaliullah-raw.json

# Pinned translation cache written by scripts/cache-pinned-translations.py
public/translations-pinned/cache/

# Legacy per-report gloss output (519 MB / 36k files). Production uses the
# lossless public/gloss-compact pools and bundles instead.
/public/gloss/

# Per-report lazy gloss slices (generated by scripts/build-gloss-lazy.py at deploy)
/public/gloss-lazy/

# Forty-hadith MP3s served from cdn.hadith.to/recitation/ after R2 upload
/public/recitation/*.mp3

# Local QA pages and harnesses — not part of the production reader
public/tests/
public/tests.html
public/recitation/r2-upload-progress.json
