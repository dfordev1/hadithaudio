{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "public",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "hadithaudio.vercel.app" }],
      "destination": "https://www.hadith.to/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "hadithaudio.vercel.app" }],
      "destination": "https://www.hadith.to/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/recitation/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
