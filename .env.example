# Copy this file to .env.local (preferred) or .env before running local scripts.
# Never commit real values.

# ElevenLabs
ELEVENLABS_API_KEY=

# Cloudflare API token flow
CF_API_TOKEN=
CLOUDFLARE_API_TOKEN=
CF_ACCOUNT_ID=
CLOUDFLARE_ACCOUNT_ID=
R2_BUCKET=hadithaudio
R2_PUBLIC_BASE=

# Cloudflare R2 S3-compatible flow
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=

# Translation pinning / caching
HADITH_API_REPO=fawazahmed0/hadith-api
HADITH_API_REF=1
HADITH_API_COMMIT=df57907be35291c91ad6a6691180e22ca9920784
TRANSLATIONS_PINNED_CACHE_DIR=public/translations-pinned/cache
